            "host": "node.example.com",
            "path": "/ws"
          }
        },
        "mux": {
          "enabled": true,
          "concurrency": 8,
          "xudpConcurrency": 16,
          "xudpProxyUDP443": "reject"
        },
        "settings": {
          "address": "node.example.com",
          "encryption": "none",
          "id": "11111111-1111-1111-1111-111111111111",
          "level": 8,
          "port": 56879
        }
      },
      {
        "protocol": "freedom",
        "settings": {
          "noises": [],
          "redirect": ""
        },
        "tag": "direct"
      },
      {
        "protocol": "blackhole",
        "settings": {
          "response": {
            "type": "http"
          }
        },
        "tag": "block"
      }
    ],
    "policy": {
      "levels": {
        "8": {
          "connIdle": 300,
          "downlinkOnly": 1,
          "handshake": 4,
          "uplinkOnly": 1
        }
      },
      "system": {
        "statsOutboundDownlink": true,
        "statsOutboundUplink": true
      }
    },
    "remarks": "node-ws-with-host",
    "routing": {
